# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local MongoDB (already running as a Windows service on this machine).
MONGODB_URI=mongodb://127.0.0.1:27017/down_south_blog

# --- Auth ---
# Change this to a long random string before deploying. Rotating it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# 3000 = public blog (Vite), 3100 = admin panel (Vite).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- First admin, created by `npm run seed` ---
SEED_ADMIN_NAME=Macka
SEED_ADMIN_EMAIL=admin@downsouthceylon.com
SEED_ADMIN_PASSWORD=ChangeMe123!
