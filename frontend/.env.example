# Base URL of the articles API. Leave blank in development so requests go
# through the Vite proxy at /api. In production set it to the deployed API origin.
VITE_API_URL=

# Public URL of the deployed blog, used for canonical links, Open Graph tags
# and structured data. Defaults to the GitHub Pages address.
VITE_SITE_URL=https://ravinduyas.github.io/the-blog/
